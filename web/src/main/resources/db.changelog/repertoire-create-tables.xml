<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="1773672843781-1" author="hahn">
        <createTable tableName="genre">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_genre"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1773672843781-2" author="hahn">
        <createTable tableName="practice_set">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_practiceset"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="creation_date" type="DATE"/>
            <column name="modification_date" type="DATE"/>
        </createTable>
    </changeSet>
    <changeSet id="1773672843781-3" author="hahn">
        <createTable tableName="practice_set_song">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_practicesetsong"/>
            </column>
            <column name="song_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="practice_set_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1773672843781-4" author="hahn">
        <createTable tableName="project">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_project"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="creation_date" type="DATE"/>
            <column name="modification_date" type="DATE"/>
        </createTable>
    </changeSet>
    <changeSet id="1773672843781-5" author="hahn">
        <createTable tableName="project_song">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_projectsong"/>
            </column>
            <column name="song_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1773672843781-6" author="hahn">
        <createTable tableName="song">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_song"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="composer" type="VARCHAR(255)"/>
            <column name="key" type="VARCHAR(255)"/>
            <column name="tuning" type="VARCHAR(255)"/>
            <column defaultValueNumeric="0" name="capo" type="integer"/>
            <column defaultValueNumeric="0" name="tempo" type="integer"/>
            <column name="genre" type="VARCHAR(255)"/>
            <column name="duration" type="VARCHAR(255)"/>
            <column defaultValueNumeric="0" name="state" type="integer"/>
            <column defaultValueNumeric="0" name="threshold" type="integer"/>
            <column name="alert" type="BOOLEAN"/>
            <column name="creation_date" type="DATE"/>
            <column name="modification_date" type="DATE"/>
            <column name="last_performed_date" type="DATE"/>
            <column defaultValueNumeric="0" name="count" type="integer"/>
        </createTable>
    </changeSet>
    <changeSet id="1773672843781-7" author="hahn">
        <createTable tableName="tuning">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tuning"/>
            </column>
            <column name="tuning" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
